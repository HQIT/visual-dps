# 应用层：只 COPY 代码，秒级重建（依赖在 base 镜像里）
# 前置: visual-dps-inference-lite-gpu-base:latest 已存在
# 构建: ./scripts/build-inference-lite-gpu-image.sh

ARG INFERENCE_LITE_GPU_BASE=visual-dps-inference-lite-gpu-base:latest
FROM ${INFERENCE_LITE_GPU_BASE}

WORKDIR /app

COPY services ./services
COPY core ./core
COPY inference_worker.py ./inference_worker.py
COPY docker/app_config.inference-gpu.json ./app_config.json

ENV INFERENCE_BACKEND=mmpose

CMD ["python", "inference_worker.py"]
